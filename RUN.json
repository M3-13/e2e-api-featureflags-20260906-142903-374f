{
  "runcontract": 1,
  "services": [
    {
      "name": "api",
      "dir": ".",
      "stack": "go",
      "kind": "server",
      "build": [["go", "build", "./..."]],
      "start": ["go", "run", "."],
      "port": 8080,
      "port_env": "PORT",
      "health": { "path": "/healthz", "expect_status": [200] },
      "env": {
        "HOST": { "dev": "127.0.0.1" },
        "PORT": { "dev": "8080" },
        "FEATUREFLAGS_API_TOKEN": {
          "external": true,
          "degraded_without": "POST /flags, PUT /flags/{key} and DELETE /flags/{key} answer 401"
        }
      }
    }
  ]
}
